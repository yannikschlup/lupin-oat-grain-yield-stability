@article{lucas2015,
  title = {The Future of Lupin as a Protein Crop in {{Europe}}},
  author = {Lucas, M. Mercedes and Stoddard, Frederick L. and Annicchiarico, Paolo and Fr{\'i}as, Juana and {Mart{\'i}nez-Villaluenga}, Cristina and Sussmann, Daniela and Duranti, Marcello and Seger, Alice and Zander, Peter M. and Pueyo, Jos{\'e} J.},
  year = 2015,
