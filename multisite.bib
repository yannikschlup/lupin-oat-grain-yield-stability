@article{puzynska2021,
  title = {Grain {{Yield}} and {{Total Protein Content}} of {{Organically Grown Oats}}--{{Vetch Mixtures Depending}} on {{Soil Type}} and {{Oats}}' {{Cultivar}}},
  author = {Pu{\.z}y{\'n}ska, Katarzyna and Pu{\.z}y{\'n}ski, Stanis{\l}aw and Synowiec, Agnieszka and Bocianowski, Jan and Lepiarczyk, Andrzej},
